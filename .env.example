# cp .env.example .env
#
# Only VITE_-prefixed variables reach the browser, and Vite inlines them at build time — setting
# one on the host afterwards changes nothing. Never put a secret here.
#
# Precedence: .env.local wins over .env; .env.production is read by `pnpm build` only.
# (`.env.prod` is read by nothing — Vite knows `.env.<mode>`, and the mode is `production`.)
#
# CI passes these from repository variables; there is no .env on a runner.

# Namespaces client-side storage keys (sessionStorage, localStorage).
VITE_PROJECT_NAME="react-app-fondation"
VITE_MAIN_WEBSITE_NAME="app"

# Base URL — canonical, og:url, robots.txt, sitemap.xml.
# Set it as a GitHub Actions repository variable too, or every deployed page ships a localhost
# canonical. Keeping a preprod out of the index is the host's job: an X-Robots-Tag header.
VITE_SITE_URL=http://localhost:3000
